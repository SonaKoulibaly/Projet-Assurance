# ═══════════════════════════════════════════════════════════════
# FICHIER .env — MODÈLE DE CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# 1. Copiez ce fichier : cp .env.example .env
# 2. Remplissez vos valeurs dans .env
# 3. Le fichier .env ne sera JAMAIS poussé sur GitHub (.gitignore)
# ═══════════════════════════════════════════════════════════════

# Clé secrète Flask/Dash (chaîne aléatoire longue)
SECRET_KEY=remplacez-par-votre-cle-secrete-longue

# Mode debug (True en local, False en production)
DEBUG=False

# Port (Render l'injecte automatiquement, ne pas changer)
# PORT=10000
